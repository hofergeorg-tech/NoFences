<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>NoFences.ico</ApplicationIcon>
    <RootNamespace>NoFences</RootNamespace>
    <AssemblyName>NoFences</AssemblyName>
    <Version>2.4.1</Version>
    <Product>NoFences</Product>
    <Description>Free desktop fences for Windows</Description>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- WinForms dark mode API is still flagged experimental -->
    <NoWarn>$(NoWarn);WFO5001;WFO5002;CA1416</NoWarn>
  </PropertyGroup>

  <!-- dotnet publish -c Release â†’ one self-contained NoFences.exe, no .NET install needed -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- ETW real-time session for the (opt-in, elevated) FPS helper -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoFences.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="NoFences.ico" LogicalName="NoFences.ico" />
    <!-- Help and changelog live in the repo root and are shown in-app -->
    <EmbeddedResource Include="..\HELP.md" LogicalName="HELP.md" />
    <EmbeddedResource Include="..\HILFE.md" LogicalName="HILFE.md" />
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <!-- WithCulture=false: otherwise ".de." makes MSBuild move it into a German satellite assembly -->
    <EmbeddedResource Include="..\CHANGELOG.de.md" LogicalName="CHANGELOG.de.md" WithCulture="false" />
    <EmbeddedResource Include="..\CHANGELOG.it.md" LogicalName="CHANGELOG.it.md" WithCulture="false" />
    <EmbeddedResource Include="..\CHANGELOG.fr.md" LogicalName="CHANGELOG.fr.md" WithCulture="false" />
    <EmbeddedResource Include="..\CHANGELOG.es.md" LogicalName="CHANGELOG.es.md" WithCulture="false" />
    <EmbeddedResource Include="..\AIUTO.md" LogicalName="AIUTO.md" />
    <EmbeddedResource Include="..\AIDE.md" LogicalName="AIDE.md" />
    <EmbeddedResource Include="..\AYUDA.md" LogicalName="AYUDA.md" />
  </ItemGroup>

</Project>
